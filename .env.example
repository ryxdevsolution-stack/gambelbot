# Copy this file to .env and fill in real values. Never commit .env.
QUOTEX_EMAIL=
QUOTEX_PASSWORD=

# Optional: for trade/day-end notifications while the bot runs unattended
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required only if you run dashboard_server.py (the browser start/stop UI).
# It can start/stop the bot and place trades, and refuses to run without
# this set. Pick something long and random -- this is what protects the
# dashboard if you expose the port to the internet (e.g. for phone access).
DASHBOARD_PASSWORD=
